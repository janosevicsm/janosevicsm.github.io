---
/**
 * Hero — full-height dark hero (design: Home.dc.html "HERO", HomeMobile.dc.html "hero").
 * Cut-out portrait, the two side labels and the endless name marquee.
 * Motion (src/scripts/home/hero.ts):
 *   03 entrance on page reveal — photo 1.08 → 1 + fade, labels rise from line masks, marquee slides in from the right
 *   04 marquee — endless loop, direction follows scroll direction, speed boosts with scroll velocity, drifts 80 px down
 *   05 photo — parallax yPercent 0 → 12 and darken to 70 % while the hero scrolls out
 * The nav top bar (Nav.astro) sits over the first ~84 px and animates itself.
 * Without JS everything is visible and the marquee is static.
 */
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait-hero.webp';
import { SITE } from '../../data/site';

const NAME = `${SITE.name} ·`;
---

<section id="hero" class="Hero" data-tone="dark" data-tone-fixed data-hero>
  <h1 class="sr-only">{SITE.name}</h1>

  <div class="photo">
    <div class="photo-in" data-hero-photo>
    <Image
      src={portrait}
      alt="Portrait of Marko Janošević"
      widths={[390, 600, 800, 1086]}
      sizes="(max-width: 760px) 100vw, min(43vw, 620px)"
      loading="eager"
      fetchpriority="high"
      class="img"
      data-hero-img
    />
    <span class="shade" aria-hidden="true" data-hero-shade></span>
    </div>
  </div>

  <div class="wrap labels">
    <p class="side side--l" data-hero-lbl>
      <span class="ln"><span><span class="dot" aria-hidden="true"></span></span></span>
      <span class="txt">
        <span class="ln"><span>Full-stack Engineer</span></span>
        <span class="ln"><span>&amp; Tech Lead</span></span>
      </span>
    </p>
    <p class="side side--r" data-hero-lbl>
      <span class="ln coords lbl"><span>{SITE.coordinates}</span></span>
      <span class="txt">
        <span class="ln"><span>Based in</span></span>
        <span class="ln"><span>{SITE.location}</span></span>
      </span>
    </p>
  </div>

  <div class="mq" aria-hidden="true" data-hero-mq>
    <div class="mq-drift" data-hero-mq-drift>
      <div class="mq-track dsp" data-hero-mq-track>
        <span>{NAME}</span><span>{NAME}</span>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/home/hero';
</script>

<style>
  .Hero {
    position: relative;
    overflow: hidden;
    min-height: max(100svh, 620px);
    isolation: isolate;
  }

  /* ---- Portrait: bottom-centred cut-out (desktop 620 × 826 at 1440) ---- */
  .photo {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 0;
    height: min(88%, 57.4vw);
    aspect-ratio: 3 / 4;
    transform: translateX(-50%);
  }
  .photo-in {
    position: absolute;
    inset: 0;
    overflow: hidden;
    will-change: transform, opacity;
  }
  .photo :global(.img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    will-change: transform;
  }
  .shade {
    position: absolute;
    inset: 0;
    background: var(--bg);
    opacity: 0;
    pointer-events: none;
  }

  /* ---- Side labels ---- */
  .labels {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    top: max(42.5%, 120px);
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
    pointer-events: none;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: clamp(15px, 9.43px + 0.714vw, 20px);
    line-height: 1.3;
  }
  .side--r {
    align-items: flex-end;
    text-align: right;
  }
  .txt {
    display: block;
  }
  .dot {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--accent);
  }
  .coords {
    color: var(--mu);
    font-size: var(--fs-label);
  }

  /* ---- Name marquee ---- */
  .mq {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 36px;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .mq-drift {
    will-change: transform;
  }
  .mq-track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    font-size: var(--fs-xxl);
    font-weight: 500;
    letter-spacing: var(--ls-xxl);
    line-height: 0.9;
    color: var(--fg);
    will-change: transform;
  }
  .mq-track > span {
    flex: none;
    padding-right: 0.18em;
  }

  /* ---- Pre-reveal state (JS on): nothing flashes before the entrance ---- */
  :global(html.js:not(.is-revealed)) .photo-in,
  :global(html.js:not(.is-revealed)) .mq {
    opacity: 0;
  }
  :global(html.js:not(.is-revealed)) .side .ln > span {
    transform: translateY(110%);
  }

  /* ---- Mobile (390 design: hero 760, photo 390 × 560, labels at 112) ---- */
  @media (max-width: 760px) {
    .photo {
      left: 0;
      right: 0;
      width: 100%;
      height: min(74%, 143.6vw);
      aspect-ratio: auto;
      transform: none;
    }
    .labels {
      top: 112px;
    }
    .side {
      gap: 10px;
    }
    .dot {
      width: 8px;
      height: 8px;
    }
    .coords {
      display: none;
    }
    .mq {
      bottom: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js:not(.is-revealed)) .side .ln > span {
      transform: none;
    }
    :global(html.js:not(.is-revealed)) .side {
      opacity: 0;
    }
  }
</style>
